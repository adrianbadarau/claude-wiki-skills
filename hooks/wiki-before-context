#!/usr/bin/env bash
set -euo pipefail

cat >/dev/null || true

context="LLM Wiki hook: before starting systematic-debugging or brainstorming, use wiki-before first. Before superpowers:brainstorming starts, use devils-advocate unless this idea was already grilled in the current conversation. wiki-before delegates to wiki-query; devils-advocate delegates to wiki-query/wiki-ingest and then hands off to brainstorming. Skip for direct wiki-query requests and ordinary current-repo code questions."

escaped=${context//\\/\\\\}
escaped=${escaped//\"/\\\"}
escaped=${escaped//$'\n'/\\n}
escaped=${escaped//$'\r'/\\r}
escaped=${escaped//$'\t'/\\t}

printf '{\n  "additionalContext": "%s",\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped" "$escaped"
