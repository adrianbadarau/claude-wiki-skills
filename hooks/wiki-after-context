#!/usr/bin/env bash
set -euo pipefail

input="$(cat || true)"

context="LLM Wiki hook: after systematic-debugging reaches confirmed root cause plus verified fix, or brainstorming reaches an approved spec, use the wiki-after skill. wiki-after must apply its judgment gate and delegate any approved filing to wiki-ingest. If the gate fails, stay silent."

escaped=${context//\\/\\\\}
escaped=${escaped//\"/\\\"}
escaped=${escaped//$'\n'/\\n}
escaped=${escaped//$'\r'/\\r}
escaped=${escaped//$'\t'/\\t}

if [[ "$input" == *'"stop_hook_active":true'* || "$input" == *'"stop_hook_active": true'* ]]; then
  printf '{}\n'
  exit 0
fi

printf '{\n  "decision": "block",\n  "reason": "%s"\n}\n' "$escaped"
